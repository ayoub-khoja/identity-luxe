# Shopify Storefront API
# Domain only, without https:// — e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=c8yerj-2i.myshopify.com

# Public token: Storefront API (X-Shopify-Storefront-Access-Token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Private token: server-side only. Never expose this to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
